{
  "expo": {
    "name": "UCC",
    "slug": "ucc",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ucc",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.ucc.community",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#11111F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "onesignal-expo-plugin",
        {
          "mode": "production",
          "disableNSE": true,
          "disableLocation": true,
          "smallIcons": ["./assets/images/android-icon-monochrome.png"],
          "smallIconAccentColor": "#8B7CF6"
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#11111F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow UCC to access your photos so you can attach images to faculty announcements."
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "onesignalAppId": "3b04746e-3970-48d8-ae9e-29f02f226aaf",
      "eas": {
        "projectId": "298e402a-7b44-4899-b5eb-710c93554bcc"
      }
    }
  }
}
